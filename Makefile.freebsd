# TigerBeetle FreeBSD Makefile
#
# Quick commands for building and running TigerBeetle on FreeBSD.
#
# Usage: make -f Makefile.freebsd <target>

# Auto-detect: prefer zig014 for API compatibility, fall back to zig
ZIG := $(or $(shell command -v zig014 2>/dev/null),$(shell command -v zig 2>/dev/null))
TARGET ?= x86_64-freebsd
MODE  ?= ReleaseSafe

.PHONY: all build check test clean run format \
        build-debug build-fast build-release \
        help

all: build

help:
	@echo "TigerBeetle FreeBSD Makefile"
	@echo ""
	@echo "Targets:"
	@echo "  make build        Build tigerbeetle (ReleaseSafe)"
	@echo "  make check        Compile-check only (fast)"
	@echo "  make build-debug  Build with Debug mode"
	@echo "  make build-fast   Build with ReleaseFast mode"
	@echo "  make test         Run unit tests"
	@echo "  make format       Format a single-node data file"
	@echo "  make run          Format + start single-node"
	@echo "  make clean        Remove build artifacts"
	@echo ""
	@echo "Variables:"
	@echo "  TARGET  Architecture (default: x86_64-freebsd)"
	@echo "  MODE    Build mode (default: ReleaseSafe)"
	@echo "  ZIG     Zig binary path (default: zig)"

build:
	$(ZIG) build -Dtarget=$(TARGET) -Doptimize=$(MODE)
	@echo "---"
	@file zig-out/bin/tigerbeetle

check:
	$(ZIG) build check -Dtarget=$(TARGET)

build-debug:
	$(MAKE) build MODE=Debug

build-fast:
	$(MAKE) build MODE=ReleaseFast

build-release:
	$(MAKE) build MODE=ReleaseSafe

test:
	$(ZIG) build test -Dtarget=$(TARGET) -Doptimize=$(MODE)

format:
	$(ZIG) build -Dtarget=$(TARGET) -Doptimize=$(MODE)
	./zig-out/bin/tigerbeetle format \
		--cluster=0 \
		--replica=0 \
		--replica-count=1 \
		--development \
		./0_0.tigerbeetle
	@echo "Data file created: ./0_0.tigerbeetle"

run: format
	./zig-out/bin/tigerbeetle start \
		--addresses=3000 \
		--development \
		./0_0.tigerbeetle

repl:
	./zig-out/bin/tigerbeetle repl \
		--cluster=0 \
		--addresses=3000

clean:
	rm -rf zig-out .zig-cache
	rm -f ./*.tigerbeetle
